# ============================================================
# Ad Performance Dashboard — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Google Ads API ----
# Developer token from your Google Ads Manager account
GOOGLE_ADS_DEVELOPER_TOKEN=INSERT_DEVELOPER_TOKEN

# OAuth2 credentials from GCP Console
GOOGLE_ADS_CLIENT_ID=INSERT_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=INSERT_CLIENT_SECRET

# Refresh token generated via google-ads CLI or OAuth2 flow
GOOGLE_ADS_REFRESH_TOKEN=INSERT_REFRESH_TOKEN

# Your Manager (MCC) account ID (no dashes, e.g. 1234567890)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=INSERT_LOGIN_CUSTOMER_ID

# The specific customer account to pull data from (no dashes)
GOOGLE_ADS_CUSTOMER_ID=INSERT_CUSTOMER_ID

# ---- Meta (Facebook) Ads API ----
# From developers.facebook.com > Your App > Settings
META_APP_ID=INSERT_APP_ID
META_APP_SECRET=INSERT_APP_SECRET

# Long-lived access token (valid ~60 days, refresh periodically)
META_ACCESS_TOKEN=INSERT_ACCESS_TOKEN

# Your Ad Account ID (format: act_XXXXXXXXXX)
META_AD_ACCOUNT_ID=act_INSERT_AD_ACCOUNT_ID

# ---- Google BigQuery ----
# GCP project ID
GCP_PROJECT_ID=INSERT_PROJECT_ID

# BigQuery dataset name (will be created if it doesn't exist)
BQ_DATASET=ad_performance

# BigQuery table name
BQ_TABLE=ad_metrics

# Path to GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# ---- App Settings ----
# Number of days to look back for data pulls (default: 30)
LOOKBACK_DAYS=30

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable mock data mode (true/false) — set to true if you don't have API credentials
USE_MOCK_DATA=true

# Skip BigQuery and save data locally as CSV (true/false)
LOCAL_MODE=true
